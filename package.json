  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.json",
    "format": "eslint --fix --ext .ts,.tsx . && prettier --write 'src/**/*.{ts,tsx}'",
    "format:check": "prettier --check .",
    "start": "react-native start",
    "test": "jest",
    "postinstall": "patch-package",
    "run-android": "./scripts/run-android.sh",
    "build-android-dev": "./scripts/build-android.sh --development",
    "build-android-prod": "./scripts/build-android.sh --production",
    "update-android-dev": "eas update --branch development --message 'Update' --platform android",
    "update-android-prod": "eas update --branch production --message 'Update' --platform android",
    "update-ios-dev": "eas update --branch development --message 'Update' --platform ios",
    "update-ios-prod": "eas update --branch production --message 'Update' --platform ios"
  },
